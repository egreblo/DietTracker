@page "/jela/novo"
@page "/jela/{Id:guid}"
@inject RecipeService Recipes
@inject NavigationManager Nav

<PageTitle>@(IsNew ? L["Novo jelo"] : recipe?.Name ?? L["Jelo"]) · Ručak</PageTitle>

<div class="page-head">
    <a class="icon-btn" href="jela" aria-label="@L["Natrag"]"><Icon Name="chevron-left" /></a>
    <h1>@(IsNew ? L["Novo jelo"] : L["Uredi jelo"])</h1>
</div>

@if (recipe is null)
{
    <p class="muted">@(notFound ? L["Jelo nije pronađeno."] : L["Učitavanje…"])</p>
}
else
{
    <form class="stack" @onsubmit="SaveAsync">
        @if (error is not null)
        {
            <div class="alert" role="alert">@error</div>
        }

        <label class="field">
            <span>@L["Naziv"]</span>
            <input type="text" required maxlength="200" placeholder="@L["npr. Pasta sa tunom"]" @bind="recipe.Name" />
        </label>

        <label class="check">
            <input type="checkbox" @bind="recipe.InPool" />
            <span>@L["U skupu za generiranje tjedna"]</span>
        </label>

        <fieldset class="field">
            <legend>@L["Sastojci"]</legend>
            @foreach (var ing in recipe.Ingredients)
            {
                <div class="ingredient-row">
                    <input type="text" placeholder="@L["Sastojak"]" aria-label="@L["Sastojak"]" @bind="ing.Name" />
                    <input type="number" min="0" step="any" inputmode="decimal" placeholder="g" aria-label="@L["Grama"]" @bind="ing.Grams" />
                    <button type="button" class="icon-btn" aria-label="@L["Ukloni sastojak"]" @onclick="() => recipe.Ingredients.Remove(ing)">
                        <Icon Name="x" Size="18" />
                    </button>
                </div>
            }
            <div><button type="button" class="btn" @onclick="AddIngredient"><Icon Name="plus" Size="18" /> @L["Dodaj sastojak"]</button></div>
        </fieldset>

        <label class="field">
            <span>@L["Priprema"]</span>
            <textarea rows="6" placeholder="@L["Koraci pripreme (opcionalno)"]" @bind="recipe.Instructions"></textarea>
        </label>

        <label class="field">
            <span>@L["Link (npr. Instagram video)"]</span>
            <input type="url" placeholder="https://" @bind="recipe.LinkUrl" />
            @if (IsHttpUrl(recipe.LinkUrl))
            {
                <a class="link-out" href="@recipe.LinkUrl" target="_blank" rel="noopener noreferrer"><Icon Name="link" Size="16" /> @L["Otvori link"]</a>
            }
        </label>

        <fieldset class="field">
            <legend>@L["Nutritivne vrijednosti po porciji (opcionalno)"]</legend>
            <div class="macro-grid">
                <label><span>kcal</span><input type="number" min="0" step="any" inputmode="decimal" @bind="recipe.Kcal" /></label>
                <label><span>@L["Proteini (g)"]</span><input type="number" min="0" step="any" inputmode="decimal" @bind="recipe.Protein" /></label>
                <label><span>@L["Ugljikohidrati (g)"]</span><input type="number" min="0" step="any" inputmode="decimal" @bind="recipe.Carbs" /></label>
                <label><span>@L["Masti (g)"]</span><input type="number" min="0" step="any" inputmode="decimal" @bind="recipe.Fat" /></label>
            </div>
        </fieldset>

        @if (recipe.Source == RecipeSource.Imported)
        {
            <p class="muted"><span class="badge web">@L["S weba"]</span> @L["Ovo jelo je uvezeno s weba."]</p>
        }

        <div class="actions">
            <button class="btn primary" type="submit" disabled="@busy">@(busy ? L["Spremanje…"] : L["Spremi"])</button>
            <a class="btn" href="jela">@L["Odustani"]</a>
            @if (!IsNew)
            {
                @if (!confirmDelete)
                {
                    <button type="button" class="btn danger push" @onclick="() => confirmDelete = true"><Icon Name="trash" Size="18" /> @L["Obriši"]</button>
                }
                else
                {
                    <button type="button" class="btn danger solid push" disabled="@busy" @onclick="DeleteAsync">@L["Potvrdi brisanje"]</button>
                }
            }
        </div>
    </form>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private Recipe? recipe;
    private bool notFound;
    private bool busy;
    private bool confirmDelete;
    private string? error;

    private bool IsNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        recipe = null;
        notFound = false;
        confirmDelete = false;
        error = null;

        if (Id is null)
        {
            recipe = new Recipe { Ingredients = [new Ingredient()] };
            return;
        }

        try
        {
            recipe = await Recipes.GetAsync(Id.Value);
            notFound = recipe is null;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            notFound = true;
        }
    }

    private void AddIngredient() => recipe!.Ingredients.Add(new Ingredient());

    private static bool IsHttpUrl(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https";

    private async Task SaveAsync()
    {
        if (recipe is null) return;
        if (string.IsNullOrWhiteSpace(recipe.Name))
        {
            error = L["Unesi naziv jela."];
            return;
        }

        recipe.Name = recipe.Name.Trim();
        recipe.Ingredients = recipe.Ingredients.Where(i => !string.IsNullOrWhiteSpace(i.Name)).ToList();
        recipe.Instructions = Blank(recipe.Instructions);
        recipe.LinkUrl = Blank(recipe.LinkUrl);
        if (recipe.LinkUrl is not null && !IsHttpUrl(recipe.LinkUrl))
        {
            error = L["Link mora početi s http:// ili https://."];
            return;
        }

        await RunAsync(async () =>
        {
            await Recipes.SaveAsync(recipe);
            Nav.NavigateTo("jela");
        });
    }

    private Task DeleteAsync() => RunAsync(async () =>
    {
        await Recipes.DeleteAsync(recipe!.Id);
        Nav.NavigateTo("jela");
    });

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        error = null;
        try { await action(); }
        catch (Exception ex) { error = ex.Message; }
        finally { busy = false; }
    }

    private static string? Blank(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
