@page "/jela/novo"
@page "/jela/{Id:guid}/uredi"

<PageTitle>@(IsNew ? L["Novo jelo"] : recipe?.Name ?? L["Jelo"]) · Ručak</PageTitle>

<div class="page-head">
    <a class="icon-btn" href="@(IsNew ? "jela" : $"jela/{Id}")" aria-label="@L["Natrag"]"><Icon Name="chevron-left" /></a>
    <h1>@(IsNew ? L["Novo jelo"] : L["Uredi jelo"])</h1>
</div>

@if (recipe is null)
{
    <p class="muted">@(notFound ? L["Jelo nije pronađeno."] : L["Učitavanje…"])</p>
}
else
{
    <form class="stack" @onsubmit="SaveAsync">
        @if (error is not null)
        {
            <div class="alert" role="alert">@error</div>
        }

        <label class="field">
            <span>@L["Naziv"]</span>
            <input type="text" required maxlength="200" placeholder="@L["npr. Pasta sa tunom"]" @bind="recipe.Name" />
        </label>

        <label class="check">
            <input type="checkbox" @bind="recipe.InPool" />
            <span>@L["U skupu za generiranje tjedna"]</span>
        </label>

        <label class="field narrow">
            <span>@L["Broj porcija"]</span>
            <input type="number" min="1" step="1" inputmode="numeric" @bind="recipe.Servings" />
        </label>

        <fieldset class="field">
            <legend>@L["Sastojci"]</legend>
            @foreach (var ing in recipe.Ingredients)
            {
                <div class="ingredient-row">
                    <input class="ing-name" type="text" placeholder="@L["Sastojak"]" aria-label="@L["Sastojak"]" @bind="ing.Name" />
                    <input type="number" min="0" step="any" inputmode="decimal" placeholder="g" aria-label="@L["Grama"]" @bind="ing.Grams" />
                    <input type="text" placeholder="@L["mjera (npr. 2 žlice)"]" aria-label="@L["Mjera"]" @bind="ing.Note" />
                    <button type="button" class="icon-btn" aria-label="@L["Ukloni sastojak"]" @onclick="() => recipe.Ingredients.Remove(ing)">
                        <Icon Name="x" Size="18" />
                    </button>
                </div>
            }
            <div><button type="button" class="btn" @onclick="AddIngredient"><Icon Name="plus" Size="18" /> @L["Dodaj sastojak"]</button></div>
        </fieldset>

        <label class="field">
            <span>@L["Priprema"]</span>
            <textarea rows="6" placeholder="@L["Koraci pripreme (opcionalno)"]" @bind="recipe.Instructions"></textarea>
        </label>

        <label class="field">
            <span>@L["Link (npr. Instagram video)"]</span>
            <input type="url" placeholder="https://" @bind="recipe.LinkUrl" />
            @if (IsHttpUrl(recipe.LinkUrl))
            {
                <a class="link-out" href="@recipe.LinkUrl" target="_blank" rel="noopener noreferrer"><Icon Name="link" Size="16" /> @L["Otvori link"]</a>
            }
        </label>

        <fieldset class="field">
            <legend>
                @L["Nutritivne vrijednosti po porciji (opcionalno)"]
                @if (recipe.MacrosEstimated) { <span class="badge">@L["procjena"]</span> }
            </legend>
            <div class="macro-grid">
                <label><span>kcal</span><input type="number" min="0" step="any" inputmode="decimal" @bind="recipe.Kcal" @bind:after="MacrosEdited" /></label>
                <label><span>@L["Proteini (g)"]</span><input type="number" min="0" step="any" inputmode="decimal" @bind="recipe.Protein" @bind:after="MacrosEdited" /></label>
                <label><span>@L["Ugljikohidrati (g)"]</span><input type="number" min="0" step="any" inputmode="decimal" @bind="recipe.Carbs" @bind:after="MacrosEdited" /></label>
                <label><span>@L["Masti (g)"]</span><input type="number" min="0" step="any" inputmode="decimal" @bind="recipe.Fat" @bind:after="MacrosEdited" /></label>
            </div>
            <div class="estimate">
                <button type="button" class="btn" @onclick="EstimateMacros"><Icon Name="shuffle" Size="18" /> @L["Procijeni iz sastojaka"]</button>
                @if (estimateMessage is not null)
                {
                    <p class="small muted">@estimateMessage</p>
                }
            </div>
        </fieldset>

        @if (recipe.Source == RecipeSource.Imported)
        {
            <p class="muted"><span class="badge web">@L["S weba"]</span> @L["Ovo jelo je uvezeno s weba."]</p>
        }

        <div class="actions">
            <button class="btn primary" type="submit" disabled="@busy">@(busy ? L["Spremanje…"] : L["Spremi"])</button>
            <a class="btn" href="@(IsNew ? "jela" : $"jela/{Id}")">@L["Odustani"]</a>
            @if (!IsNew)
            {
                @if (!confirmDelete)
                {
                    <button type="button" class="btn danger push" @onclick="() => confirmDelete = true"><Icon Name="trash" Size="18" /> @L["Obriši"]</button>
                }
                else
                {
                    <button type="button" class="btn danger solid push" disabled="@busy" @onclick="DeleteAsync">@L["Potvrdi brisanje"]</button>
                }
            }
        </div>
    </form>
}
